{
  "name": "@nexus-terminal/workspace",
  "version": "0.0.1-dev.3",
  "type": "module",
  "description": "SSH terminals, files, server status and quick commands",
  "files": [
    "dist"
  ],
  "exports": {},
  "scripts": {
    "build": "node ../../scripts/build-plugin.mjs",
    "typecheck": "vue-tsc --noEmit",
    "test:setup": "playwright install --with-deps chromium",
    "test": "pnpm build && vitest run"
  },
  "peerDependencies": {
    "nexus-terminal": "^1.1.0"
  },
  "nexus": {
    "kind": "application",
    "icon": "square-terminal",
    "entry": {
      "backend": "dist/node/index.js",
      "frontend": "dist/browser/index.js"
    },
    "dependsOn": {
      "@nexus-terminal/credentials": "^0.0.1-dev.2",
      "@nexus-terminal/connections": "^0.0.1-dev.2",
      "@nexus-terminal/ssh": "^0.0.1-dev.1",
      "@nexus-terminal/remote-tools": "^0.0.1-dev.1"
    },
    "i18n": {
      "zh-CN": {
        "description": "SSH 终端、文件管理、服务器状态和快捷指令"
      }
    }
  },
  "engines": {
    "node": ">=26.13.1"
  }
}
