{
  "name": "@nexus-terminal/credentials",
  "version": "0.0.1-dev.4",
  "type": "module",
  "description": "Manage usernames, passwords and SSH keys",
  "displayName": "Credentials",
  "files": [
    "dist"
  ],
  "exports": {
    "./credentials-api": {
      "types": "./dist/types/node/credentials-api.d.ts"
    },
    "./credentials-client-api": {
      "types": "./dist/types/browser/credentials-client-api.d.ts"
    }
  },
  "peerDependencies": {
    "nexus-terminal": "^1.1.0"
  },
  "engines": {
    "node": ">=26.13.1"
  },
  "scripts": {
    "build": "node ../../scripts/build-plugin.mjs",
    "test:setup": "playwright install --with-deps chromium",
    "typecheck": "vue-tsc -p tsconfig.json --noEmit",
    "test": "pnpm build && tsx --test tests/*.test.ts"
  },
  "nexus": {
    "kind": "application",
    "icon": "key-round",
    "entry": {
      "backend": "dist/node/index.js",
      "frontend": "dist/browser/index.js"
    },
    "dependsOn": {
      "@nexus-terminal/ssh": "^0.0.1-dev.1"
    },
    "i18n": {
      "zh-CN": {
        "description": "管理用户名、密码和 SSH 密钥",
        "displayName": "认证管理"
      }
    }
  }
}
