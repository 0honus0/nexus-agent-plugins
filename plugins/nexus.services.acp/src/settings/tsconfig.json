{
  "compilerOptions": {
    "target": "ES2025",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "lib": ["ES2025", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["vite/client", "node"],
    "paths": { "@settings-ui/*": ["../../../../lib/settings-ui/*"] }
  },
  "include": ["./**/*.ts", "./**/*.vue", "../../../../lib/settings-ui/**/*.ts", "../../../../lib/settings-ui/**/*.vue"]
}
