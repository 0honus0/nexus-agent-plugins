[
  {
    "id": "@nexus-terminal/ssh",
    "versions": [
      {
        "package": {
          "name": "@nexus-terminal/ssh",
          "version": "0.0.1-dev.1",
          "type": "module",
          "description": "SSH connections, terminals, commands, SFTP and port forwarding",
          "files": [
            "dist"
          ],
          "exports": {
            "./ssh-api": {
              "types": "./dist/node/ssh-api.d.ts"
            }
          },
          "peerDependencies": {
            "nexus-terminal": "^1.0.0"
          },
          "engines": {
            "node": ">=26.13.1"
          },
          "nexus": {
            "kind": "extension",
            "entry": {
              "backend": "dist/node/index.js"
            },
            "i18n": {
              "zh-CN": {
                "description": "提供 SSH 连接、终端、命令执行、SFTP 和端口转发"
              }
            }
          },
          "scripts": {
            "build": "node scripts/build.mjs",
            "typecheck": "tsc -p tsconfig.json",
            "test": "pnpm build && tsx --test tests/*.test.ts"
          }
        },
        "distributions": [
          {
            "tarball": "https://github.com/0honus0/nexus-plugin/releases/download/ssh/v0.0.1-dev.1/ssh-0.0.1-dev.1.tgz",
            "integrity": "sha512-npAlxp9gp+mUQFDjXgivJZLZxfuidV/5eskrDzkQn20/uzGsReD8RrM2CVM2wkwS1YZqNWnwEpONYgz9QWmRsA=="
          }
        ]
      }
    ]
  },
  {
    "id": "@nexus-terminal/credentials",
    "versions": [
      {
        "package": {
          "name": "@nexus-terminal/credentials",
          "version": "0.0.1-dev.1",
          "type": "module",
          "description": "Manage usernames, passwords and SSH keys",
          "files": [
            "dist"
          ],
          "exports": {
            "./credentials-api": {
              "types": "./dist/types/node/credentials-api.d.ts"
            },
            "./credentials-client-api": {
              "types": "./dist/types/browser/credentials-client-api.d.ts"
            }
          },
          "peerDependencies": {
            "nexus-terminal": "^1.1.0"
          },
          "engines": {
            "node": ">=26.13.1"
          },
          "nexus": {
            "kind": "application",
            "entry": {
              "backend": "dist/node/index.js",
              "frontend": "dist/browser/index.js"
            },
            "dependsOn": {
              "@nexus-terminal/ssh": "^0.0.1-dev.1"
            },
            "i18n": {
              "zh-CN": {
                "description": "管理用户名、密码和 SSH 密钥"
              }
            }
          },
          "scripts": {
            "build": "node ../../scripts/build-plugin.mjs",
            "test:setup": "playwright install --with-deps chromium",
            "typecheck": "vue-tsc -p tsconfig.json --noEmit",
            "test": "pnpm build && tsx --test tests/*.test.ts"
          }
        },
        "distributions": [
          {
            "tarball": "https://github.com/0honus0/nexus-plugin/releases/download/credentials/v0.0.1-dev.1/credentials-0.0.1-dev.1.tgz",
            "integrity": "sha512-KbbCKCjVTchZBtGWFrwFcCGvQg4k/x1t3mJZiXxESTcifUUdFdfdUbee8Y4fmBnm7kD7tDQ/OAXL5vpmbbcE4g=="
          }
        ]
      }
    ]
  }
]
